# ---------------------------------------------------------------------------
# FreshKeep — .gitignore
#
# Deliberately stack-agnostic: the technology stack is not chosen yet (see
# docs/decisions/0002-technology-stack.md). Sections for stacks not in use are
# harmless, and prune them once the stack is decided.
# ---------------------------------------------------------------------------

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Secrets and local config
# NEVER commit real credentials, API keys or tokens. Commit a .env.example
# with the variable *names* and dummy values instead, so a reviewer knows
# what to set without ever seeing a secret.
.env
.env.*
!.env.example
*.pem
*.key

# Logs and temporary files
*.log
logs/
tmp/
.cache/

# Node / JavaScript
node_modules/
dist/
build/
coverage/
.next/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Java / Kotlin / Android
target/
*.class
.gradle/
local.properties

# Databases
*.sqlite
*.sqlite3
*.db
